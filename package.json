{
  "name": "acortador-links",
  "version": "1.0.0",
  "description": "Acortador de URLs con Node.js, Express, TypeScript y PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "nanoid": "3.3.8",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "ts-node-dev": "2.0.0",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.6.5"
}
